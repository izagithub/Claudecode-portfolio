---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { allProjects } from '../../../data/projects';

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Portfolio`}>
	<Nav current="project" slug={project.slug} />
	<main class="px-[10px]">
		<section class={`relative mt-[20px] h-[calc(100vh_-_214px)] overflow-hidden rounded-[5px] bg-neutral-300 ${project.layout === 'narrow' ? 'w-1/3' : 'w-full'}`}>
			{project.heroMedia?.type === 'video' && (
				<div class="relative h-full w-full">
					<video
						id="hero-video"
						class="h-full w-full object-cover"
						src={project.heroMedia.src}
						autoplay
						muted
						loop
						playsinline
					/>
					<button
    id="mute-btn"
    class="absolute bottom-[5px] left-[5px] z-10 flex items-center justify-center rounded-[25px] bg-white px-[10px] py-[3px] text-[12px] text-black"
>
    sound off
</button>
				</div>
			)}
			{project.heroMedia?.type === 'image' && (
				<img class="h-full w-full object-cover" src={project.heroMedia.src} alt={project.title} />
			)}
			{project.slides && project.slides.length > 0 && (
				<div id="slideshow" class="relative h-full w-full">
					{project.slides.map((src, i) => (
						<img
							src={src}
							alt={`${project.title} ${i + 1}`}
							class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
							data-slide={i}
						/>
					))}
				</div>
			)}
		</section>
		{project.slug === 'microinterventions' && (
    <div class="mt-6 w-full">
        <div class="flex gap-[34px] mt-3 mb-3" style="height: 400px;">
            <div class="w-2/5">
                <p class="text-[19px] text-black mb-4 leading-tight">
                    A lot of users struggle to stay focused and intentional being online because many digital products are designed to continuously compete for their attention. How might we create a gentle, behavioral intervention that raises user awareness during mindless scrolling without breaking their workflow completely?
                </p>
                <p class="text-[19px] text-black leading-tight">
                    Our solution is a set of browser extensions designed to encourage intentional, mindful and focused interactions with digital tools. Leveraging AI tools allowed us to skip complex environments and build a functional, testable proof-of-concept.
                </p>
            </div>
            <video
                class="rounded-[30px] object-cover"
                style="width: calc(60% - 3px);"
                src="/plugins-animation-second.mp4"
                autoplay
                muted
                loop
                playsinline
            />
        </div>
        <div class="flex flex-col gap-[6px] mt-3">
            <video
                class="rounded-[5px] object-cover w-full mb-11"
                src="/plugins-animation-s.mp4"
                autoplay
                muted
                loop
                playsinline
            />
            <video
                class="rounded-[5px] object-cover w-full"
                src="/plugins-animation-c.mp4"
                autoplay
                muted
                loop
                playsinline
            />
        </div>
    </div>
)}
{project.slug === 'communication-gear' && (
    <div class="mt-6 w-full">
        <div class="flex gap-[40px] mb-8">
            <div class="w-1/2">
                <p class="text-[19px] text-black mb-0 leading-tight">
                    A set of accessories designed for post-training gatherings within choreographic processes. In body-based practices such as dance, physical boundaries often become blurred. Constant physical contact and intensive collaboration make expressing personal limits particularly challenging. The project explores a series of communication tools that support choreographic processes by enabling clearer communication in moments of physical and emotional overload.
                </p>
            </div>
        </div>
        <div class="flex gap-[16px] mb-4">
        <p class="text-[19px] text-black mb-4 leading-tight">
        One of the accessories is an analog conversation gear system designed for four participants. Each set consists of headphones, a handheld "microphone," and an optional GoPro camera that records the interaction. The system is designed with a maximum cable span of 9–10 meters between participants, allowing movement and conversation while maintaining physical connection.
         </p>   
            <img src="/communication-gear-main2.jpg" class="w-1/2 rounded-[30px] object-cover" />
        </div>
        <div class="flex gap-[40px]">
            <div class="flex-1">
                <p class="text-[19px] text-black leading-tight">
                    The headphone component is inspired by contemporary sports bone-conduction headphones. Due to the analog wired construction of the system, conventional in-ear headphones were unsuitable because they could easily fall out during movement. Over-ear headphones were also impractical, as their closed design prevented sound from being delivered directly into the ear canal. The final form was therefore developed to maximize the integration of bodily movement into the communication process.
                </p>
            </div>
            <div class="flex flex-col gap-[16px]" style="width: 50%;">
                <div class="flex gap-[16px]">
                    <img src="/communication-gear-one.jpg" class="w-1/2 rounded-[5px] object-cover" />
                    <img src="/communication-gear-two.jpg" class="w-1/2 rounded-[5px] object-cover" />
                </div>
                <img src="/communication-gear-three.jpg" class="w-full rounded-[5px] object-cover" />
            </div>
        </div>
        <div class="flex gap-[40px] mt-4">
            <div class="flex-1">
                <p class="text-[19px] text-black leading-tight">
                    A lightweight sports vest serves as the primary structural element of the set. It provides an ergonomic way to route the cables used during conversation while also incorporating a mounting point for an optional GoPro camera. This solution supports unrestricted movement and reinforces the physical, embodied nature of the interaction.
                </p>
            </div>
            <div style="width: 50%;">
                <img src="/communication-gear-four.jpg" class="w-full rounded-[5px] object-cover" />
            </div>
        </div>
    </div>
)}
{project.slug === 'watch-me-burn' && (
    <div class="mt-6 w-full pb-5">
        <div class="flex gap-[5px]">
            <div class="w-3/7">
                <p class="text-[16.8px] text-black mb-2">
                    Watch me burn (2024) explores the complexities of digital identity verification, focusing on the exhausting and often invasive procedures individuals are required to undergo in order to authenticate themselves online.
                </p>
                <div class="accordion-item mb-0">
                    <button class="accordion-btn text-[16.8px] text-black text-left w-full" data-target="wmb-description">
                        Description
                    </button>
                    <div id="wmb-description" class="accordion-content overflow-hidden max-h-0 transition-all duration-300">
                        <p class="text-[16.8px] text-black mt-2 mb-2">
                            The video takes the form of a monologue from the perspective of a protagonist struggling with acts of public self-authentication, reflecting broader tensions between individual autonomy and the systemic demands imposed by digital infrastructures. The work intentionally adopts a longer and more exhausting temporal structure than typically expected within TikTok's environment. Fragmented footage adopts a distinctly TikTok-native visual language, situating the work within the broader social and technological environment in which contemporary processes of online identity verification take place.
                        </p>
                        <p class="text-[16.8px] text-black">
                            Form and Meaning course led by Jeremiasz Rzenno at the Academy of Fine Arts in Katowice.
                        </p>
                    </div>
                </div>
                <p class="text-[16.8px] text-black mt-2">Displayed at</p>
                <p class="text-[16.8px] text-[#787878] mb-4">
                    Ujazdowski Contemporary Art Centre (2024) Warsaw<br/>
                    Impuls Event (2026) Katowice
                </p>
                <p class="text-[16.8px] text-black">Tools</p>
                <p class="text-[16.8px] text-[#787878]">
                    Metahuman, Unreal Engine, After Effect
                </p>
            </div>
        </div>
    </div>
)}
	{project.slug === 'color-of-air' && (
    <div class="mt-6 w-1/3 px-0">
        <p class="text-[16.8px] text-black mb-4">
            The Color of Air (2019) is an installation that integrates code with building. The project incorporates code, digital fabrication methods, and construction practices.
        </p>
        <p class="text-[16.8px] text-black mb-4">
            Student Design Team: Nicole Capps, Akshata Dusa, Roni Feghaly, Tyler Forsberg, Diana Kraczkowska, Mary Beth Robbins, Christopher Rubio, Jessica Shremshock, Anastasiya Skvarniuk, Zachary Standley, and Izabela Szumniak.
            University of Tennessee College of Architecture + Design.
            Supervisor: Nate Imai.
        </p>
        <a href="https://www.arcc-arch.org/wp-content/uploads/2022/05/Imai-Nate-Shigeo_Building-with-Air-The-Internet-of-Things-IoT-as-a-Pedagogical-Tool-for-Design-Build-Education.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[16.8px] text-black underline"
        >
            Read more here
        </a>
    </div>
)}
	</main>
	<script>
    document.querySelectorAll('.accordion-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-target');
            const content = document.getElementById(target);
            if (content.style.maxHeight && content.style.maxHeight !== '0px') {
                content.style.maxHeight = '0px';
            } else {
                content.style.maxHeight = content.scrollHeight + 'px';
            }
        });
    });
</script>
</Layout>

<script>
	const video = document.getElementById('hero-video') as HTMLVideoElement;
	const btn = document.getElementById('mute-btn');
	if (video && btn) {
		btn.addEventListener('click', () => {
			video.muted = !video.muted;
			btn.textContent = video.muted ? 'sound off' : 'sound on';
		});
	}

	const slides = document.querySelectorAll('[data-slide]');
	if (slides.length > 1) {
		let current = 0;
		setInterval(() => {
			(slides[current] as HTMLElement).style.opacity = '0';
			current = (current + 1) % slides.length;
			(slides[current] as HTMLElement).style.opacity = '1';
		}, 5000);
	}
</script>