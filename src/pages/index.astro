---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { recentProjects, archivedProjects } from '../data/projects';

const mediumUrl =
  'https://medium.com/@izaszumniak/why-building-digital-trust-feels-so-exhausting-ccdf04e6f475';
---

<Layout title="Work — Portfolio">
	<Nav current="work" />
	<main class="px-[10px] pb-10">
		<section class="mt-[20px] mb-4 md:mb-30">
			<div class="gallery-recent relative grid grid-cols-1 md:grid-cols-3 gap-[6px]">
				{
					recentProjects.map((project) => (
						<a href={`/projects/${project.slug}`} class="block relative group/card mb-[90px] md:mb-0 h-[calc(100vh_-_100px)] md:h-[calc(100vh_-_230px)]" data-tags={project.tags || ''} data-collaborator={project.collaborator || ''}>
							{project.cover
								? <img src={project.cover} class={`h-full w-full object-cover rounded-[5px] transition-opacity duration-300 ${project.hoverVideo ? 'group-hover/card:opacity-0' : ''}`} />
								: <div class="h-full w-full bg-neutral-300 rounded-[5px]" />
							}
							{project.hoverVideo && project.slug === 'microinterventions' && (
								<video
									class="absolute inset-0 h-full w-full object-cover rounded-[5px] opacity-0 group-hover/card:opacity-100 transition-opacity duration-300"
									src={project.hoverVideo}
									muted
									loop
									playsinline
									data-hover-video
								/>
							)}
							<p class="absolute bottom-[-34px] left-0 text-[16.8px] text-black">{project.title}</p>
{project.tags && <p class="absolute bottom-[-54px] leading-tight left-0 text-[15px] text-[#787878]">{project.tags}</p>}
						</a>
					))
				}
			</div>
		</section>

		<section>
			<span class="mb-6 inline-block text-[16.8px] text-black font-medium">
				Archived work
			</span>
			<span id="external-label" class="pointer-events-none fixed z-50 hidden text-[12px] font-medium leading-tight" style="font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif; max-width: 200px;">External link</span>
			<ul class="flex flex-col gap-3">
				<li class="relative">
    <a href={mediumUrl} target="_blank" rel="noopener noreferrer" class="text-black leading-tight block">
        UX article on Medium: Why does building digital trust feels so exhausting
    </a>
    <p class="text-[15px] leading-tight mt-0 text-[#787878]">UX writing & research</p>
</li>
				{
					archivedProjects.map((project) => (
						<li>
    <a href={`/projects/${project.slug}`} class="text-black block">
        {project.title}
    </a>
    {project.tags && <p class="text-[15px] mt-0 leading-tight text-[#787878]">{project.tags}</p>}
</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<script>
document.querySelectorAll('[data-hover-video]').forEach(video => {
	const el = video as HTMLVideoElement;
	const card = el.closest('.group\\/card');
	card?.addEventListener('mouseenter', () => el.play());
	card?.addEventListener('mouseleave', () => { el.pause(); el.currentTime = 0; });
});
const externalLabel = document.getElementById('external-label');
const externalLink = document.querySelector('a[href*="medium.com"]');
if (externalLink && externalLabel) {
    externalLink.addEventListener('mouseenter', () => externalLabel.classList.remove('hidden'));
    externalLink.addEventListener('mouseleave', () => externalLabel.classList.add('hidden'));
    externalLink.addEventListener('mousemove', (e) => {
        externalLabel.style.left = e.clientX + 15 + 'px';
        externalLabel.style.top = e.clientY + 15 + 'px';
    });
}
</script>
