---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="About — Portfolio">
    <Nav current="about" />
    <main class="px-[10px] pb-20">
        <div class="mt-6 w-full md:w-2/5">
            <div class="flex justify-start md:hidden mb-4">
                <audio id="about-mobile" src="/About.mp3"></audio>
                <button id="audio-btn-mobile" class="text-[16.8px] text-black cursor-pointer">
                    sound off
                </button>
            </div>
            <div class="flex gap-[40px] items-start">
                <div class="flex-1">
                    <p class="text-[16.8px] text-black mb-6 leading-tight">
                        I'm a Product and Interaction Designer with a background in architecture, creative direction and UX design. I use research, storytelling, prototyping, and AI-assisted development to design products grounded in how people think, behave, and interact with emerging technology.
                    </p>
                    <p class="text-[16.8px] text-[#787878] mb-1 leading-tight">Capabilities:</p>
                    <p class="text-[16.8px] text-black mb-1 leading-tight">Research</p>
                    <p class="text-[16.8px] text-black mb-1 leading-tight">Storytelling</p>
                    <p class="text-[16.8px] text-black mb-1 leading-tight">Digital Products</p>
                    <p class="text-[16.8px] text-black mb-6 leading-tight">AI-assisted Development</p>
                    <div class="mt-6">
                        <p class="text-[16.8px] text-[#787878] mb-1 leading-tight">Get in touch:</p>
                        <a href="https://www.linkedin.com/in/izabela-szumniak-0554822a1" target="_blank" rel="noopener noreferrer" class="text-[16.8px] text-black block leading-tight">linkedIn</a>
                        <a href="mailto:izaszumniak@gmail.com" class="text-[16.8px] text-black block leading-tight">email</a>
                    </div>
                </div>
                <div class="hidden md:block">
                    <audio id="about-desktop" src="/About.mp3"></audio>
                    <button id="audio-btn-desktop" class="text-[16.8px] text-black cursor-pointer whitespace-nowrap">
                        sound off
                    </button>
                </div>
            </div>
        </div>
    </main>
    <script>
        function setupAudio(audioId, btnId) {
            const audio = document.getElementById(audioId) as HTMLAudioElement;
            const btn = document.getElementById(btnId);
            if (audio && btn) {
                btn.addEventListener('click', () => {
                    if (audio.paused) {
                        audio.play();
                        btn.textContent = 'sound on';
                    } else {
                        audio.pause();
                        btn.textContent = 'sound off';
                    }
                });
            }
        }
        setupAudio('about-mobile', 'audio-btn-mobile');
        setupAudio('about-desktop', 'audio-btn-desktop');
    </script>
</Layout>